<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_product_search_inherit_operational_area" model="ir.ui.view">
        <field name="name">sale.report.search.inherit.operational.area</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='User']" position="after">
                <filter string="Operational Area" name="operational_area" context="{'group_by':'operational_area_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>